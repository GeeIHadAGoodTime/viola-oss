{
  "manifest_version": 3,
  "name": "Viola Browser Bridge",
  "version": "1.1.1",
  "description": "Checks whether your local Viola runtime is reachable.",
  "permissions": [],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://api.useviola.com/*",
    "https://useviola.com/*",
    "https://www.useviola.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
